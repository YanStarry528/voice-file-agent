# ===== 公司第三方中转（OpenAI 兼容网关）配置 =====
# 使用方式：复制本文件为 .env，并填入真实值。
# 本项目只会读取下面这几个变量，变量名不要改。

# 1. 中转平台下发的密钥（一般是 sk- 开头，直接整段粘贴）
API_KEY=sk-xxxxxx

# 2. 中转平台网关地址，务必以 /v1 结尾
#    openai SDK 会在它后面自动拼 /chat/completions
BASE_URL=https://your-gateway/v1

# 3. 本地语音转文字模型（faster-whisper，不走中转）：tiny / base / small
#    越大越准也越慢，中文建议 base 或 small
WHISPER_MODEL=base

# 4. 意图分类模型：必须是中转网关支持的模型 ID
LLM_MODEL=deepseek-v4-flash
